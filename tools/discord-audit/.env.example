# Copy this file to .env (same folder) and fill it in. .env is never committed.

# Bot page of https://discord.com/developers/applications -> Reset Token -> Copy
DISCORD_BOT_TOKEN=

# Optional when the bot is only in one server. Right-click the server icon ->
# Copy Server ID (needs Developer Mode in Discord settings -> Advanced).
DISCORD_GUILD_ID=

# Optional: only for the automatic audit (python audit.py). Without it, run
# "python audit.py --export-only" and upload out\discord-messages.md to Claude.
ANTHROPIC_API_KEY=
